{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DragonBoardLauncher services.json",
  "description": "启动管理器服务定义（P1.1 外置）。路径支持 ${repoRoot} 变量插值；externalPolicy: managed|reuse|refuse。",
  "type": "object",
  "required": ["services"],
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": "string" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "keys"],
        "properties": {
          "name": { "type": "string" },
          "keys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "port"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "workingDirectory": { "type": "string" },
          "fileName": { "type": "string" },
          "arguments": { "type": "string" },
          "fallbackFileName": { "type": "string" },
          "fallbackArguments": { "type": "string" },
          "envVars": { "type": "object", "additionalProperties": { "type": "string" } },
          "isVoiceWorker": { "type": "boolean" },
          "externalPolicy": { "enum": ["managed", "reuse", "refuse"] },
          "logOnlyErrors": { "type": "boolean" },
          "logPolicy": {
            "type": "object",
            "properties": {
              "level": { "enum": ["all", "errors-only", "filter-access"] },
              "suppressHealth": { "type": "boolean" }
            }
          },
          "comment": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
