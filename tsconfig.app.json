{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/*",
    "src/devtools/**",
    "src/流程图/**",
    "src/constants/dataLoader.ts",
    "src/services/AlgorithmManager.ts",
    "src/services/dragon/BusinessRules.ts",
    "src/services/dragon/BusinessValidator.ts",
    "src/services/dragon/ContextBuilder.ts",
    "src/**/*-bak.ts",
    "src/**/*0310.ts",
    "src/**/*0305.ts",
    "src/**/*0304.ts",
    "src/**/*0306.ts",
    "src/**/*—bak.vue"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
