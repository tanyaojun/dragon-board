{
  "name": "dragon-board",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ranktrend": "vitest run src/services/rankTrend/__tests__ src/services/__tests__/RankTrendAnalyzer.test.ts",
    "typecheck:ranktrend": "tsc --noEmit -p tsconfig.ranktrend.json",
    "update-themes": "node scripts/updateThemeMapping.js",
    "update-themes:dev": "cross-env NODE_ENV=development node scripts/updateThemeMapping.js",
    "update-themes:prod": "cross-env NODE_ENV=production node scripts/updateThemeMapping.js",
    "update-themes:monthly": "node scripts/updateThemeMapping.js && echo '题材映射已更新'"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "lunar-javascript": "^1.7.7",
    "pinia": "^2.1.0",
    "uuid": "^14.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.9.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
